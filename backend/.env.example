# =============================================================================
# ALOFT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
#
# SECRET MANAGEMENT OPTIONS:
# --------------------------
# This application supports multiple secret management backends:
# 1. Environment Variables (default) - Set secrets directly in this .env file
# 2. AWS Secrets Manager - Set AWS_REGION or AWS_DEFAULT_REGION
# 3. Azure Key Vault - Set AZURE_CLIENT_ID and AZURE_KEY_VAULT_URL
# 4. Google Secret Manager - Set GOOGLE_APPLICATION_CREDENTIALS or GOOGLE_CLOUD_PROJECT
#
# The app auto-detects the appropriate backend based on environment variables.
# For production, use a proper secret manager instead of environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_CONTACT_EMAIL=dev@aloft.app

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# REQUIRED - MongoDB connection string with SSL/TLS enabled
# Development: mongodb://localhost:27017/?directConnection=true
# Production: mongodb+srv://user:pass@cluster.mongodb.net/aloft (with SSL)
# Note: SSL/TLS is automatically enabled in production environments
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=aloft

# MongoDB Docker Compose Credentials (REQUIRED for docker-compose.yml)
# Generate strong passwords: python -c "import secrets; print(secrets.token_urlsafe(16))"
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password

# -----------------------------------------------------------------------------
# Redis Configuration (optional - for rate limiting and sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security - JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# In production, set to specific origins: ["https://aloft.app", "https://www.aloft.app"]
# Use ["*"] for development only
CORS_ALLOWED_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# CSP Configuration
# -----------------------------------------------------------------------------
# In production, set to specific API domains: ["https://api.groq.com", "https://api.elevenlabs.io"]
# Leave empty for development defaults
CSP_ALLOWED_CONNECT_ORIGINS=[]

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_ALGORITHM=sliding
RATE_LIMIT_FLIGHT_LOOKUPS_PER_HOUR=10
RATE_LIMIT_CONTENT_GENERATION_PER_HOUR=20
RATE_LIMIT_POSITION_UPDATES_PER_MINUTE=600
RATE_LIMIT_POI_DISCOVERY_PER_HOUR=30
RATE_LIMIT_STORY_GENERATION_PER_HOUR=50
RATE_LIMIT_AUDIO_SYNTHESIS_PER_HOUR=30
RATE_LIMIT_DOWNLOADS_PER_HOUR=10
RATE_LIMIT_SESSION_CREATION_PER_HOUR=20
RATE_LIMIT_MIXED_AUDIO_PER_HOUR=15
RATE_LIMIT_IMAGE_RETRIEVAL_PER_HOUR=40

# -----------------------------------------------------------------------------
# Account Lockout Settings
# -----------------------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# Content Generation Settings
# -----------------------------------------------------------------------------
CONTENT_GENERATION_MAX_CONCURRENT=3
CONTENT_INTER_POI_DELAY_SECONDS=3.0
CONTENT_INTER_IMAGE_DELAY_SECONDS=1.0
CONTENT_RATE_LIMIT_BACKOFF_SECONDS=60.0
CONTENT_MAX_POI_RETRIES=3

# -----------------------------------------------------------------------------
# Session Settings
# -----------------------------------------------------------------------------
SESSION_TTL_SECONDS=43200

# -----------------------------------------------------------------------------
# Geographic Settings
# -----------------------------------------------------------------------------
CORRIDOR_WIDTH_KM=100.0
MAX_CURATED_POIS_PER_ROUTE=30
DESTINATION_HIGHLIGHTS_COUNT=20
DESTINATION_TOUR_INTERVAL_MINUTES=8
POI_MIN_SPACING_KM=150.0

# -----------------------------------------------------------------------------
# API Keys - Required Services
# -----------------------------------------------------------------------------
# Get your API keys from the respective service dashboards
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Audio quality for speech narration. mp3_22050_64 is recommended: transparent
# quality for voice, half the bandwidth/storage of the higher-quality options.
# Options: mp3_22050_32, mp3_22050_64, mp3_44100_64, mp3_44100_128, mp3_44100_192
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_64
# AviationStack: 500 requests/month free (fallback for flight resolution)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
# AeroDataBox via RapidAPI: 500 requests/month free, no credit card required
# Primary flight resolver -- returns airport coordinates in one call (vs 3 for AviationStack)
# Sign up at: rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 Configuration (optional - for audio storage)
# -----------------------------------------------------------------------------
# Leave unset to use local disk storage
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# -----------------------------------------------------------------------------
# Audio Storage Directory (local fallback)
# -----------------------------------------------------------------------------
AUDIO_STORAGE_DIR=./audio_storage

# -----------------------------------------------------------------------------
# POI Source Feature Flags
# -----------------------------------------------------------------------------
POI_SOURCE_WIKIDATA_ENABLED=false
POI_SOURCE_GEONAMES_ENABLED=false
POI_SOURCE_OVERPASS_ENABLED=false
GEONAMES_USERNAME=your_geonames_username

# -----------------------------------------------------------------------------
# Openverse Image Fallback (optional)
# -----------------------------------------------------------------------------
OPENVERSE_CLIENT_ID=your_openverse_client_id
OPENVERSE_CLIENT_SECRET=your_openverse_client_secret

# -----------------------------------------------------------------------------
# OpenSky Network (optional - for live aircraft positions)
# -----------------------------------------------------------------------------
# OpenSky uses OAuth2 client credentials (basic username/password was retired).
# Without credentials: ~100 anonymous requests/day (usually enough for testing).
# With credentials:    ~4,000 requests/day — required for any real usage.
#
# Setup (free):
#   1. Create an account at https://opensky-network.org
#   2. Go to Account → API Client → Create new client
#   3. Copy the client_id and client_secret below
#
# Leave both blank to use anonymous access (limited but functional).
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret

# -----------------------------------------------------------------------------
# Email Service Configuration
# -----------------------------------------------------------------------------
# Configure either Resend or SendGrid
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@aloft.app

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Base URL for password reset links and email verification
# Development: http://localhost:5500 (the aloft-frontend/ static server — see
#   its README; `python3 -m http.server 5500` from that directory)
# Production: https://aloft.app
# NOTE: the reset-password link is built as "{FRONTEND_BASE_URL}/reset-password.html?token=..."
#   — the aloft-frontend pages are plain .html files, so the extension matters here.
FRONTEND_BASE_URL=http://localhost:5500

# -----------------------------------------------------------------------------
# OneSignal Push Notifications (optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://onesignal.com/
# Free tier: 10,000 notifications/month
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES FOR PRODUCTION
# =============================================================================
# The following environment variables MUST be set in production:
#
# 1. JWT_SECRET_KEY - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# 2. MONGODB_URI - Production MongoDB connection string with SSL
# 3. ENVIRONMENT - Set to "production"
# 4. CORS_ALLOWED_ORIGINS - Set to your actual frontend domain(s)
# 5. FRONTEND_BASE_URL - Set to your actual frontend URL
#
# OPTIONAL BUT RECOMMENDED:
# - REDIS_URL - For rate limiting and session management
# - GROQ_API_KEY - For AI content generation
# - ELEVENLABS_API_KEY - For audio synthesis
# - AVIATIONSTACK_API_KEY - For flight data fallback
# - RESEND_API_KEY or SENDGRID_API_KEY - For email services
#
# DEVELOPMENT BYPASS FLAGS (NEVER USE IN PRODUCTION):
# - SKIP_EMAIL_VERIFICATION=true - Allows unverified accounts (dev only)
# =============================================================================
